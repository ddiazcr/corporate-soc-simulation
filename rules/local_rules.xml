<!--
  Corporate SOC Simulation - Nimbrek S.A.
  Custom Wazuh detection rules for Active Directory attacks (Phase 3)

  Install on the Wazuh manager as its own rule file:
    sudo cp local_rules.xml /var/ossec/etc/rules/nimbrek_rules.xml
    sudo chown wazuh:wazuh /var/ossec/etc/rules/nimbrek_rules.xml
  Test each rule with a sample event before restarting:
    sudo /var/ossec/bin/wazuh-logtest
  Then: sudo systemctl restart wazuh-manager

  These rules chain off Wazuh 4.9.2's built-in Windows ruleset
  (ruleset/rules/0580-win-security_rules.xml). Parents used:
    60122  4625 logon failure (bad user or password)
    60204  multiple logon failures from one IP (8 in 240 s)
    60104  generic audit failure (4771 has no dedicated built-in rule)
    60106  logon success, which also covers 4769 service tickets
    60103  generic audit success (4662 directory-service access)
    60154 / 60159 / 60166 / 60167  Administrators / Domain Admins /
           Schema Admins / Enterprise Admins group changed

  Field names: inside rules the decoded fields are win.system.* and
  win.eventdata.*. The "data." prefix only exists in the indexed alert
  (dashboard, alerts.json), never in rule definitions.

  Rule IDs 100200-100299 are reserved for this project.
-->

<group name="nimbrek,active_directory,attack,">

  <!--
    T1110.001 - Brute force (VALIDATED 2026-10-19)
    Self-correlating detection: 8+ failed logons (event 4625 -> 60122) from the
    same source IP within 240 s. This mirrors the proven pattern of rule 100201
    (if_matched_sid 60122 + same_field ipAddress).

    Why not chain off the built-in 60204? In this 4.9.2 install, 60204
    ("Multiple Windows Logon Failures") did not fire for these events even with
    a populated source IP: it uses <if_matched_group>authentication_failed</if_matched_group>,
    whereas <if_matched_sid>60122</if_matched_sid> (as 100201 uses) correlates
    reliably. So 100200 was rewritten to self-correlate off 60122 instead of
    depending on 60204.

    Distinct from 100201 (spraying): 100200 counts repeated failures against one
    or few accounts from a single IP (same_field ipAddress only); 100201 counts
    failures spread across 6+ different accounts (adds different_field
    targetUserName). Same user hammered -> 100200; many users sprayed -> 100201.
  -->
  <rule id="100200" level="12" frequency="8" timeframe="240">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Nimbrek: brute force against domain controller - 8+ failed logons from $(win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!--
    T1110.003 - Password spraying over NTLM/SMB (event 4625)
    Same source failing against several different accounts (one try each)
    is the spraying signature, distinct from hammering a single account.
    Level 13 so it outranks 100200 when both fire on the same burst
    (6 accounts here vs. 8 failures for 60204).
  -->
  <rule id="100201" level="13" frequency="6" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <different_field>win.eventdata.targetUserName</different_field>
    <description>Nimbrek: possible password spraying (NTLM) - 6+ accounts targeted from $(win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <!--
    Kerberos pre-authentication failure (event 4771).
    Wazuh 4.9.2 has no dedicated rule for 4771; it only reaches the generic
    audit-failure rule 60104. This base rule gives it an ID to correlate on.
    Status 0x18 = wrong password (the one spraying tools such as kerbrute produce).
  -->
  <rule id="100202" level="5">
    <if_sid>60104</if_sid>
    <field name="win.system.eventID">^4771$</field>
    <description>Nimbrek: Kerberos pre-authentication failed for $(win.eventdata.targetUserName) (status $(win.eventdata.status))</description>
    <group>authentication_failed,kerberos,</group>
  </rule>

  <!--
    T1110.003 - Password spraying over Kerberos (event 4771)
  -->
  <rule id="100203" level="13" frequency="6" timeframe="120">
    <if_matched_sid>100202</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <different_field>win.eventdata.targetUserName</different_field>
    <description>Nimbrek: possible password spraying (Kerberos) - 6+ accounts failed pre-auth from $(win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
    <group>authentication_failures,kerberos,</group>
  </rule>

  <!--
    T1558.003 - Kerberoasting
    Kerberos service-ticket request (4769) using weak RC4 encryption (0x17).
    In 4.9.2 a successful 4769 is classified by 60106 ("Windows Logon Success"),
    so the rule must chain from there and pin the event ID.
    A burst of these for different services is a strong Kerberoasting signal.
  -->
  <rule id="100210" level="8">
    <if_sid>60106</if_sid>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>
    <description>Nimbrek: Kerberos service ticket for $(win.eventdata.serviceName) requested with weak RC4 (possible Kerberoasting)</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>kerberos,</group>
  </rule>

  <rule id="100211" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100210</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <different_field>win.eventdata.serviceName</different_field>
    <description>Nimbrek: possible Kerberoasting - RC4 tickets for 5+ services from $(win.eventdata.ipAddress) in 60s</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>kerberos,</group>
  </rule>

  <!--
    T1558.003 - Kerberoasting against the honeytoken (single request).
    svc_sql_backup exists only as a tripwire, so ONE ticket request for it is
    already high-fidelity; it must not wait for the 5-service burst of 100211.
    Level 12 so it reaches the AI triage threshold (>= 10).
  -->
  <rule id="100212" level="12">
    <if_sid>100210</if_sid>
    <field name="win.eventdata.serviceName">^svc_sql_backup$</field>
    <description>Nimbrek: Kerberos ticket requested for honeytoken svc_sql_backup from $(win.eventdata.ipAddress) - Kerberoasting</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>kerberos,honeytoken,</group>
  </rule>

  <!--
    T1087.002 - Domain account discovery via a decoy object.
    Only the decoy account adm_backup_legacy carries a "Read Property" SACL
    (scripts/Setup-DiscoveryDecoy.ps1), so a 4662 read (access mask 0x10) on a
    user-class object (bf967aba-...) means something enumerated it: LDAP
    dumps, BloodHound/SharpHound, netexec user listing. Machine accounts ($) are
    excluded to ignore the DC's own housekeeping.
    Parent 60103 = generic Windows audit success (4662 has no dedicated rule);
    confirm with wazuh-logtest before deploying.
  -->
  <rule id="100230" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4662$</field>
    <field name="win.eventdata.accessMask">^0x10$</field>
    <field name="win.eventdata.objectType" type="pcre2">(?i)bf967aba-0de6-11d0-a285-00aa003049e2</field>
    <field name="win.eventdata.subjectUserName" type="pcre2" negate="yes">\$$</field>
    <description>Nimbrek: decoy account read in AD by $(win.eventdata.subjectUserName) - possible domain account discovery</description>
    <mitre>
      <id>T1087.002</id>
    </mitre>
    <group>discovery,honeytoken,</group>
  </rule>

  <!--
    T1098 - Account manipulation: member ADDED to a privileged group.
    The built-in privileged-group rules (level 12) fire on both additions
    and removals, and they are evaluated before any sibling custom rule, so
    a rule hanging from 60141/60144/60151 would never see these groups.
    This rule chains off the privileged-group rules and keeps only additions
    (4728 global / 4732 local / 4756 universal).
  -->
  <rule id="100220" level="13">
    <if_sid>60154,60159,60166,60167</if_sid>
    <field name="win.system.eventID">^4728$|^4732$|^4756$</field>
    <description>Nimbrek: member added to privileged group $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>account_changes,group_changed,</group>
  </rule>

  <!--
    T1546.008 - Event Triggered Execution: Accessibility Features.
    The logon-screen accessibility helpers (sethc.exe sticky keys, utilman.exe
    ease-of-access, osk, magnify, narrator, displayswitch) run as SYSTEM before
    authentication. Replacing one with cmd.exe (or any change to it) is a classic
    pre-auth SYSTEM backdoor - and is exactly the technique used to recover this
    DC after its password was lost (see docs/incident-reports.md). These files
    never change outside a Windows servicing event, so a FIM change is
    high-fidelity.

    Requires Wazuh FIM. Add to the DC agent's ossec.conf, inside <syscheck>:
      <directories check_all="yes" realtime="yes">C:\Windows\System32\sethc.exe</directories>
      <directories check_all="yes" realtime="yes">C:\Windows\System32\utilman.exe</directories>
      <directories check_all="yes" realtime="yes">C:\Windows\System32\osk.exe</directories>
      <directories check_all="yes" realtime="yes">C:\Windows\System32\Magnify.exe</directories>
      <directories check_all="yes" realtime="yes">C:\Windows\System32\Narrator.exe</directories>
      <directories check_all="yes" realtime="yes">C:\Windows\System32\DisplaySwitch.exe</directories>
    Parents 550 (checksum changed) and 554 (file added) are Wazuh's built-in FIM rules.

    Registry variant (not file-based): an attacker can instead set a Debugger
    value under HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File
    Execution Options\sethc.exe. That is caught by event 4657 (registry value
    set) or by Wazuh registry syscheck, and is tracked as a separate hardening
    item rather than duplicated here.
  -->
  <rule id="100240" level="13">
    <if_sid>550,554</if_sid>
    <field name="file" type="pcre2">(?i)\\System32\\(sethc|utilman|osk|Magnify|Narrator|DisplaySwitch)\.exe$</field>
    <description>Nimbrek: accessibility binary modified in System32 ($(file)) - possible T1546.008 sticky-keys/utilman backdoor</description>
    <mitre>
      <id>T1546.008</id>
    </mitre>
    <group>fim,persistence,privilege_escalation,pci_dss_11.5,</group>
  </rule>

</group>
