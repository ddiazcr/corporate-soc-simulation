<!--
  Corporate SOC Simulation - Nimbrek S.A.
  Custom Wazuh detection rules for Active Directory attacks (Phase 3)

  Install on the Wazuh manager:
    append to /var/ossec/etc/rules/local_rules.xml
    then: sudo systemctl restart wazuh-manager

  These rules sit on top of Wazuh's built-in Windows ruleset
  (group "windows,", event 4625 -> rule 60122; event 4769 -> rule 60176).
  Rule IDs 100200-100299 are reserved for this project.
-->

<group name="nimbrek,active_directory,attack,">

  <!--
    T1110.001 - Brute force (VALIDATED)
    Wazuh's built-in rule 60204 ("Multiple Windows Logon Failures") already
    correlates repeated 4625 events. Instead of duplicating that correlation,
    this rule chains off 60204 to raise the severity and attach the Nimbrek
    context and the precise sub-technique. Chaining (if_sid) avoids the
    frequency race where the native rule consumes the matched events first.
  -->
  <rule id="100200" level="12">
    <if_sid>60204</if_sid>
    <description>Nimbrek: brute force against domain controller - multiple failed logons from $(data.win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!--
    T1110.003 - Password spraying
    Same source failing against several different accounts (one try each)
    is the spraying signature, distinct from hammering a single account.
  -->
  <rule id="100201" level="12" frequency="6" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>data.win.eventdata.ipAddress</same_field>
    <different_field>data.win.eventdata.targetUserName</different_field>
    <description>Nimbrek: possible password spraying - 6+ accounts targeted from $(data.win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <!--
    T1558.003 - Kerberoasting
    Kerberos service-ticket request (4769) using weak RC4 encryption (0x17).
    A burst of these for different services is a strong Kerberoasting signal.
  -->
  <rule id="100210" level="8">
    <if_sid>60176</if_sid>
    <field name="data.win.eventdata.ticketEncryptionType">0x17</field>
    <description>Nimbrek: Kerberos service ticket requested with weak RC4 (possible Kerberoasting prep)</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>kerberos,</group>
  </rule>

  <rule id="100211" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100210</if_matched_sid>
    <same_field>data.win.eventdata.ipAddress</same_field>
    <description>Nimbrek: possible Kerberoasting - 5+ RC4 service tickets from $(data.win.eventdata.ipAddress) in 60s</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>kerberos,</group>
  </rule>

  <!--
    T1098 - Account manipulation
    A member added to a privileged group (4728 global / 4732 local / 4756 universal).
  -->
  <rule id="100220" level="12">
    <if_sid>60137,60138,60140</if_sid>
    <description>Nimbrek: member added to a privileged group ($(data.win.eventdata.targetUserName))</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>account_changes,</group>
  </rule>

</group>
